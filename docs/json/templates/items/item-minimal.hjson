{

  // name: 内容显示名称。
  // 可以直接写在内容文件中，也可以通过 bundle 本地化。
  name: "模板名称",

  // description: 内容简介。
  // 显示在游戏内内容详情页。
  description: "这是一个模板示例。",

  // details: 内容隐藏详情。
  // 可通过游戏内界面查看。
  details: "这是模板的隐藏详情。",

  // color: 物品代表色。
  // 使用 6 位 RGB 或 8 位 RGBA 十六进制颜色。
  color: "39C5BB",

  // research: 科技树父节点。
  // 填写原版或本模组中已存在内容的内部名称。
  research: "copper"}
