{

  // name: 内容显示名称。
  // 可以直接写在内容文件中，也可以通过 bundle 本地化。
  name: "模板名称",

  // description: 内容简介。
  // 显示在游戏内内容详情页。
  description: "这是一个模板示例。",

  // details: 内容隐藏详情。
  // 可通过游戏内界面查看。
  details: "这是模板的隐藏详情。",

  // type: 方块类型。
  // OreBlock 是矿物地板，使用钻头可以采集出对应物品。
  type: "OreBlock",

  // ore: 采集后获得的物品内部名称。
  ore: "titanium",

  // itemDrop: 掉落的物品，通常与 ore 相同。
  itemDrop: "titanium",

  // playerUnmineable: 玩家是否无法手动挖掘。
  playerUnmineable: true,

  // variants: 贴图变体数量。
  variants: 3,

  // research: 科技树父节点。
  research: "titanium"
}
