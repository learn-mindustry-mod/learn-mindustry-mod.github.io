{

  // name: 内容显示名称。
  // 可以直接写在内容文件中，也可以通过 bundle 本地化。
  name: "模板名称",

  // description: 内容简介。
  // 显示在游戏内内容详情页。
  description: "这是一个模板示例。",

  // details: 内容隐藏详情。
  // 可通过游戏内界面查看。
  details: "这是模板的隐藏详情。",

  // type: 方块类型。
  // UnitFactory 是单位工厂，消耗资源生产单位。
  type: "UnitFactory",

  // size: 方块尺寸。
  size: 3,

  // health: 生命值。
  health: 500,

  // category: 建造分类。
  category: "production",

  // requirements: 建造需求。
  requirements: [
    "copper/100",
    "lead/80",
    "silicon/60"
  ],

  // produceTime: 生产一个单位所需时间（刻）。
  produceTime: 300,

  // plans: 可生产的单位列表。
  plans: [
    {
      // unit: 生产出的单位内部名称。
      unit: "flare",

      // requirements: 生产该单位所需资源。
      requirements: [
        "copper/10",
        "lead/5"
      ]
    }
  ],

  // consumes: 消耗配置。
  consumes: {
    // power: 生产期间消耗的电力。
    power: 2
  },

  // research: 科技树父节点。
  research: "air-factory"
}
