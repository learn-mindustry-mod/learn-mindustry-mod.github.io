{

  // name: 内容显示名称。
  // 可以直接写在内容文件中，也可以通过 bundle 本地化。
  name: "模板名称",

  // description: 内容简介。
  // 显示在游戏内内容详情页。
  description: "这是一个模板示例。",

  // details: 内容隐藏详情。
  // 可通过游戏内界面查看。
  details: "这是模板的隐藏详情。",

  // type: 方块类型。
  // ThermalGenerator 是热能发电机，需要放置在具有 heat 属性的地板上。
  type: "ThermalGenerator",

  // size: 方块尺寸。
  size: 3,

  // health: 生命值。
  health: 360,

  // category: 建造分类。
  category: "power",

  // requirements: 建造需求。
  requirements: [
    "copper/80",
    "lead/60",
    "graphite/60"
  ],

  // powerProduction: 基础发电量。
  // 实际发电量会根据地板 heat 属性倍率变化。
  powerProduction: 3.6,

  // attribute: 依赖的地板属性。
  attribute: "heat",

  // floating: 是否允许建造在液体地表上。
  floating: true,

  // consumesPower: 是否消耗电力。
  consumesPower: false,

  // outputsPower: 是否输出电力。
  outputsPower: true,

  // research: 科技树父节点。
  research: "thermal-generator"
}
