{

  // name: 内容显示名称。
  // 可以直接写在内容文件中，也可以通过 bundle 本地化。
  name: "模板名称",

  // description: 内容简介。
  // 显示在游戏内内容详情页。
  description: "这是一个模板示例。",

  // details: 内容隐藏详情。
  // 可通过游戏内界面查看。
  details: "这是模板的隐藏详情。",

  // type: 方块类型。
  // Sorter 是物品分类器，只允许指定物品通过。
  type: "Sorter",

  // size: 方块尺寸。
  size: 1,

  // health: 生命值。
  health: 50,

  // category: 建造分类。
  category: "distribution",

  // requirements: 建造需求。
  requirements: [
    "copper/2",
    "lead/2"
  ],

  // filter: 允许通过的物品内部名称。
  filter: "copper",

  // invert: 是否反向过滤。
  // true 时表示除 filter 以外的物品都可以通过。
  invert: false,

  // research: 科技树父节点。
  research: "sorter"
}
