{

  // name: 内容显示名称。
  // 可以直接写在内容文件中，也可以通过 bundle 本地化。
  name: "模板名称",

  // description: 内容简介。
  // 显示在游戏内内容详情页。
  description: "这是一个模板示例。",

  // details: 内容隐藏详情。
  // 可通过游戏内界面查看。
  details: "这是模板的隐藏详情。",

  // type: 方块类型。
  // LogicBlock 是逻辑处理器方块，可以运行逻辑代码。
  type: "LogicBlock",

  // size: 方块尺寸。
  size: 1,

  // health: 生命值。
  health: 80,

  // category: 建造分类。
  category: "logic",

  // requirements: 建造需求。
  requirements: [
    "copper/20",
    "lead/20",
    "silicon/10"
  ],

  // instructionsPerTick: 每刻可执行的指令数。
  instructionsPerTick: 1,

  // range: 逻辑方块与链接方块之间的最大范围。
  range: 8,

  // maxInstructions: 最大指令数。
  maxInstructions: 50,

  // research: 科技树父节点。
  research: "message"
}
