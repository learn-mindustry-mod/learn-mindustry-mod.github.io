{

  // name: 内容显示名称。
  // 可以直接写在内容文件中，也可以通过 bundle 本地化。
  name: "模板名称",

  // description: 内容简介。
  // 显示在游戏内内容详情页。
  description: "这是一个模板示例。",

  // details: 内容隐藏详情。
  // 可通过游戏内界面查看。
  details: "这是模板的隐藏详情。",

  // type: 方块类型。
  // Router 是物品路由器，将输入的物品平均分发给相邻输出方向。
  type: "Router",

  // size: 方块尺寸。
  size: 1,

  // health: 生命值。
  health: 60,

  // category: 建造分类。
  category: "distribution",

  // requirements: 建造需求。
  requirements: [
    "copper/3"
  ],

  // speed: 分发速度。
  speed: 0.05,

  // research: 科技树父节点。
  research: "router"
}
