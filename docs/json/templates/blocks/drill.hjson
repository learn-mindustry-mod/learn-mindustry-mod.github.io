{

  // name: 内容显示名称。
  // 可以直接写在内容文件中，也可以通过 bundle 本地化。
  name: "模板名称",

  // description: 内容简介。
  // 显示在游戏内内容详情页。
  description: "这是一个模板示例。",

  // details: 内容隐藏详情。
  // 可通过游戏内界面查看。
  details: "这是模板的隐藏详情。",

  // type: 方块类型。
  // Drill 是挖掘地面矿物的钻头类方块。
  type: "Drill",

  // size: 方块尺寸。
  size: 2,

  // health: 生命值。
  health: 200,

  // category: 建造分类。
  category: "production",

  // requirements: 建造需求。
  requirements: [
    "copper/60",
    "lead/30"],

  // drillTime: 采集时间。
  // 单位为刻，数值越小采集越快。
  drillTime: 200,

  // size: 采掘范围由 size 决定，这里重复列出仅为提示。
  // 钻头尺寸越大，可采掘的矿物范围越大。

  // alwaysUnlocked: 是否始终解锁。
  alwaysUnlocked: false,

  // research: 科技树父节点。
  research: "mechanical-drill"}
