{

  // name: 内容显示名称。
  // 可以直接写在内容文件中，也可以通过 bundle 本地化。
  name: "模板名称",

  // description: 内容简介。
  // 显示在游戏内内容详情页。
  description: "这是一个模板示例。",

  // details: 内容隐藏详情。
  // 可通过游戏内界面查看。
  details: "这是模板的隐藏详情。",

  // type: 方块类型。
  // LiquidJunction 是液体交汇点，让多条管道可以交叉通过。
  type: "LiquidJunction",

  // size: 方块尺寸。
  size: 1,

  // health: 生命值。
  health: 50,

  // category: 建造分类。
  category: "distribution",

  // requirements: 建造需求。
  requirements: [
    "copper/2"
  ],

  // liquidCapacity: 液体缓冲容量。
  liquidCapacity: 6,

  // liquidPressure: 液体压力。
  liquidPressure: 1,

  // research: 科技树父节点。
  research: "liquid-junction"
}
