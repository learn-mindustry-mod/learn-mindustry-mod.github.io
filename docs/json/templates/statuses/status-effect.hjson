{

  // name: 内容显示名称。
  // 可以直接写在内容文件中，也可以通过 bundle 本地化。
  name: "模板名称",

  // description: 内容简介。
  // 显示在游戏内内容详情页。
  description: "这是一个模板示例。",

  // details: 内容隐藏详情。
  // 可通过游戏内界面查看。
  details: "这是模板的隐藏详情。",

  // type: 状态效果类型。
  // 通常为 StatusEffect。
  type: "StatusEffect",

  // color: 状态效果颜色。
  color: "FFD580",

  // speedMultiplier: 移动速度倍率。
  // 小于 1 表示减速，大于 1 表示加速。
  speedMultiplier: 0.8,

  // damage: 每秒伤害。
  // 如果不需要伤害，设置为 0。
  damage: 0,

  // healthMultiplier: 生命值倍率。
  // 小于 1 表示降低最大生命值。
  healthMultiplier: 1,

  // effect: 持续特效。
  // 例如 burning、wet、melting 等原版特效。
  effect: "none",

  // research: 科技树父节点。
  // 状态效果通常不需要科技树，但可以按需设置。
  research: "slow"}
